{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@e2e/ui": ["./packages/ui/src/index.ts"],
      "@e2e/utils": ["./packages/utils/src/index.ts"]
    }
  },
  "include": [
    "bun.d.ts",
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "apps/*/src/**/*"
  ]
}
